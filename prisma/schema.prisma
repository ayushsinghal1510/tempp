// PrepAI — AI interview-preparation platform
// Schema follows §3 of the build brief. jsonb columns use Prisma `Json`.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  // Both point at Neon's DIRECT endpoint — its PgBouncer pooler adds a flat
  // ~1s tax to every query (measured). src/lib/db.ts retries once on the
  // stale-connection error (P1017) that autosuspend causes here instead.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────── enums ───────────────────────────────

enum Role {
  super_admin
  admin
  student
  practice
  // Educator on the practice track — owns a PracticeOrg, creates companies
  // and assigns them to groups of `practice` students. Distinct from `admin`,
  // which is the university-side placement officer bound to a University and
  // the Cohort/Student tree.
  practice_admin
  // Admissions counsellor on the calling track (tenant `nimc`). Dials leads
  // over PSTN and reads back the transcript. Owns no companies and runs no
  // rounds — the whole surface is the dialler and the call history.
  nimc_counsellor
}

// Whether the educator may see the transcript + recording of the rounds a
// student runs under an assignment, or only the scores and analytics.
// Chosen per assignment so a batch can mix private drills with graded
// assessments; the student is shown which before they start.
enum PracticeAssignmentMode {
  drill // scores + analytics only
  assessment // + transcript and recording
}

// Educator-created companies start `draft` so the research can be reviewed
// and edited before students see it. Self-serve companies are created
// `published` directly, preserving the existing student flow.
enum PracticeCompanyStatus {
  draft
  published
}

// The educator's own judgement of whether a student is ready to sit a real
// interview. Deliberately NOT derived from scores: the rubric measures how one
// session went, and "ready" is a call about a person that an educator makes
// after watching several of them plus everything the product never sees.
//
// `not_ready` is the default for the same reason — readiness is something an
// educator confers, so nobody is ready until somebody says so. It is not a
// judgement about a new student, and no UI should read it as one.
enum StudentReadiness {
  not_ready
  ready
}

// Which product a practice account is using. Decided by email domain at
// signup (see src/lib/tenants/config.ts) and then read from the row, never
// recomputed — so accounts that predate the domain rule keep working.
//
//   jer → the original interview track: companies, resumes, the
//         posture/framing/approach/numbers/confidence/example rubric.
//   nim → the clinical track for medical students: educator-authored patient
//         scenarios, no company and no resume, and the
//         presence/rapport/listening/empathy/plainlanguage/dignity rubric.
//
//   cus → a managed customer deployment: the customer's own admin writes the
//         greeting and the prompt, every user of that customer sees it
//         immediately, and sessions are recorded and transcribed but never
//         scored. No rubric, no companies, no scenarios, no assignments.
//
//   nimc → the outbound calling track. A counsellor types a phone number and
//          the agent dials it over PSTN (call.voxio.in/plivo/outbound rather
//          than the WebRTC offer every other tenant uses). The same webhook
//          delivers the transcript, but the per-turn extraction is flat
//          strings (name, course, percentage) instead of scored topic dicts.
//          Nothing is scored, so `topics` is empty here for the same reason
//          it is on `cus`.
//
// All four share every model, route and chart below — the tenant selects a
// rubric, a prompt and a set of feature flags, not a separate schema.
enum Tenant {
  jer
  nim
  cus
  nimc
  mm
  pr
}

// PracticeCompany does triple duty across the tenants: an employer to
// interview for (jer), a simulated patient encounter (nim), or a customer's
// own prompt (cus). This discriminates them. Reusing one table is deliberate —
// assignments, access control, visibility modes and the whole educator UI hang
// off PracticeCompany, and forking it would mean maintaining parallel copies
// of the access rules.
enum PracticeCompanyKind {
  company
  scenario
  workflow
}

// Where a session's webcam recording is in its journey from the browser to
// disk. The student is released from the call the moment it ends, so the
// results page needs to distinguish "there was never a recording" from
// "it's still on its way" — otherwise a slow upload reads as a broken replay.
enum RecordingStatus {
  none // no recording was captured (mic-only session, unsupported browser)
  processing // the upload is in flight
  ready // on disk and playable
  failed // the upload errored or never arrived
}

enum CohortStatus {
  draft // created, research not yet run
  researching // company research in progress
  active // sessions scheduled / running
  completed
}

enum SessionStatus {
  pending
  in_progress
  completed
}

enum RoundType {
  coaching
  test
}

enum RoundStatus {
  pending
  in_progress
  completed
}

enum Speaker {
  student
  agent
}

// Who spoke on a `nimc` outbound call. Kept separate from `Speaker` because
// the other end of this call is a prospective student who has no account here
// — calling them `student` would collide with the practice-track meaning.
enum CallSpeaker {
  agent
  lead
}

// How an outbound call ended.
//
// Only `connected` and `declined_immediately` are inferable from what we
// receive today: the webhook fires on the graph's ask_for_input node, so a
// call that never connects produces no events at all and `turns == 0` is our
// proxy for it. The remaining values need a Plivo status callback we do not
// consume yet — they are declared now so adding that callback later is a
// writer change rather than a migration.
enum CallOutcome {
  connected
  no_answer
  busy
  invalid_number
  wrong_person
  declined_immediately
  callback_requested
  voicemail
}

// Company salary band. Derived from salaryLpa on the vacancy:
// >10 LPA = tier_1, 4–10 = tier_2, <4 = tier_3.
enum Tier {
  tier_1
  tier_2
  tier_3
}

// Practice-flow student degree — keys the expectation matrix
// (src/lib/research/expectationMatrix.ts) alongside the student's own CGPA.
enum Degree {
  btech
  mtech
  bba
  mba
  bca
  mca
  bcom
  mcom
}

// ─────────────────────────────── models ───────────────────────────────

model University {
  id               String   @id @default(cuid())
  name             String
  sessionsAllotted Int      @default(0) @map("sessions_allotted")
  sessionsUsed     Int      @default(0) @map("sessions_used")
  createdAt        DateTime @default(now()) @map("created_at")

  users    User[]
  students Student[]
  cohorts  Cohort[]

  @@map("universities")
}

model User {
  id            String  @id @default(cuid())
  // Nullable: super_admin (platform operator) belongs to no university.
  universityId  String? @map("university_id")
  // Populated only for role = practice_admin — the educator's institute.
  // Practice *students* are not attached to an org directly; their link is
  // their PracticeMember rows, so a student can leave a class without their
  // account or their self-created companies changing hands.
  practiceOrgId String? @map("practice_org_id")
  role          Role
  name          String
  email         String  @unique
  passwordHash  String  @map("password_hash")
  // Which practice product this account uses. Defaulting to `jer` is what
  // grandfathers every account that predates the email-domain rule — they
  // keep logging in and land on the interview track exactly as before.
  // Meaningless for the B2B roles (super_admin/admin/student), which never
  // read it.
  tenant        Tenant  @default(jer)
  // Populated only for role = practice — the student's own degree + CGPA,
  // used to key the expectation matrix (course focus areas on the drive
  // briefing page). Null for every other role, and for practice accounts
  // created before this field existed.
  course        Degree?
  cgpa          Float?
  // Educator-set, role = practice only. Every other role carries the default
  // and never reads it. See StudentReadiness for why this is a person's call
  // and not a computed one.
  readiness     StudentReadiness @default(not_ready)

  createdAt DateTime @default(now()) @map("created_at")

  university          University?          @relation(fields: [universityId], references: [id], onDelete: SetNull)
  practiceOrg         PracticeOrg?         @relation(fields: [practiceOrgId], references: [id], onDelete: SetNull)
  student             Student? // populated only when role = student
  practiceRounds      PracticeRound[] // populated only when role = practice
  practiceCompanies   PracticeCompany[] // populated only when role = practice
  practiceResumeChat  PracticeResumeChat[] // populated only when role = practice
  resumeStudios       PracticeResumeStudio[] // populated only when role = practice
  practiceMemberships PracticeMember[] // populated only when role = practice
  practiceAssignments PracticeAssignment[] // populated only when role = practice
  leadCalls           LeadCall[] // populated only when role = nimc_counsellor

  @@index([universityId])
  @@index([practiceOrgId])
  @@map("users")
}

model Student {
  id              String  @id @default(cuid())
  userId          String  @unique @map("user_id")
  universityId    String  @map("university_id")
  name            String
  email           String
  academicPercent Float   @map("academic_percent") // powers the hero mispricing scatter (X axis); = average of semesterScores
  branch          String?
  cgpa            Float?
  rollNumber      String? @map("roll_number")
  course          String? // e.g. "B.Tech CSE"
  // Prior-semester percentages (5th-sem students → 4 entries). number[].
  semesterScores  Json?   @map("semester_scores")

  createdAt DateTime @default(now()) @map("created_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  university     University      @relation(fields: [universityId], references: [id], onDelete: Cascade)
  cohortStudents CohortStudent[]
  sessions       Session[]

  @@index([universityId])
  @@map("students")
}

model Cohort {
  id              String       @id @default(cuid())
  universityId    String       @map("university_id")
  companyName     String       @map("company_name")
  status          CohortStatus @default(draft)
  // Company profile produced by the research step (what they ask, question style,
  // focus areas, ranked question themes).
  companyResearch Json?        @map("company_research")
  // When the company's on-campus drive / interviews happen. Drives the student's
  // "upcoming" ordering.
  driveDate       DateTime?    @map("drive_date")
  createdAt       DateTime     @default(now()) @map("created_at")

  university     University      @relation(fields: [universityId], references: [id], onDelete: Cascade)
  vacancies      Vacancy[]
  cohortStudents CohortStudent[]
  sessions       Session[]

  @@index([universityId])
  @@map("cohorts")
}

model Vacancy {
  id                 String @id @default(cuid())
  cohortId           String @map("cohort_id")
  jobTitle           String @map("job_title")
  jobDescription     String @map("job_description")
  // Ordered array of skills, highest priority first.
  skillPriorities    Json   @map("skill_priorities")
  salaryLpa          Float? @map("salary_lpa")
  tier               Tier? // salary band, derived from salaryLpa
  minAcademicPercent Float? @map("min_academic_percent") // eligibility gate

  cohort         Cohort          @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  cohortStudents CohortStudent[]

  @@index([cohortId])
  @@map("vacancies")
}

model CohortStudent {
  id        String  @id @default(cuid())
  cohortId  String  @map("cohort_id")
  studentId String  @map("student_id")
  vacancyId String? @map("vacancy_id")

  cohort  Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  vacancy Vacancy? @relation(fields: [vacancyId], references: [id], onDelete: SetNull)

  @@unique([cohortId, studentId])
  @@index([cohortId])
  @@index([studentId])
  @@map("cohort_students")
}

model Session {
  id            String        @id @default(cuid())
  cohortId      String        @map("cohort_id")
  studentId     String        @map("student_id")
  sessionNumber Int           @map("session_number")
  status        SessionStatus @default(pending)
  scheduledAt   DateTime?     @map("scheduled_at")
  startedAt     DateTime?     @map("started_at")
  completedAt   DateTime?     @map("completed_at")

  cohort  Cohort  @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  rounds  Round[]

  @@index([cohortId])
  @@index([studentId])
  @@map("sessions")
}

model Round {
  id              String      @id @default(cuid())
  sessionId       String      @map("session_id")
  // The single most important privacy-bearing field: coaching rounds are
  // student-private; test rounds are visible to admin too. Enforced at API layer.
  type            RoundType
  roundNumber     Int         @map("round_number")
  status          RoundStatus @default(pending)
  durationSeconds Int?        @map("duration_seconds")
  overallScore    Float?      @map("overall_score")
  startedAt       DateTime?   @map("started_at")
  completedAt     DateTime?   @map("completed_at")

  session   Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  turns     Turn[]
  scores    RoundScore?
  feedback  RoundFeedback?
  recording Recording?

  @@index([sessionId])
  @@index([type])
  @@map("rounds")
}

model Turn {
  id           String   @id @default(cuid())
  roundId      String   @map("round_id")
  turnNumber   Int      @map("turn_number")
  speaker      Speaker
  transcript   String
  // Captured live, NEVER displayed live (brief §5). Shown only in the
  // after-round score-timeline replay.
  delta        Float?
  runningScore Float?   @map("running_score")
  // The 5 canonical skills at this point in the round (0-10) — drives the
  // coaching-replay timeline. Student turns only; null on agent turns.
  skills       Json?    @map("skills")
  // Visual/delivery observations (posture, gaze). HARD BOUNDARY: student-private
  // only, behaviour-not-motive. Never surfaced to admin.
  visualFlags  Json?    @map("visual_flags")
  timestamp    DateTime @default(now())

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([roundId])
  @@map("turns")
}

model RoundScore {
  id             String @id @default(cuid())
  roundId        String @unique @map("round_id")
  // THE canonical 5 coachable skills (0-10). This is the one measurement model
  // — plotted on the radar, cohort bars, and retention slope. See skill model.
  framing        Float // 0-10
  ownership      Float // 0-10
  quantification Float // 0-10
  concision      Float // 0-10
  approach       Float // 0-10

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@map("round_scores")
}

model RoundFeedback {
  id                   String @id @default(cuid())
  roundId              String @unique @map("round_id")
  summaryMd            String @map("summary_md")
  whatWentWell         Json   @map("what_went_well") // string[]
  areasToImprove       Json   @map("areas_to_improve") // string[]
  coachingAdoptionRate Float? @map("coaching_adoption_rate") // 0-1: coachability signal

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@map("round_feedback")
}

model Recording {
  id            String  @id @default(cuid())
  roundId       String  @unique @map("round_id")
  videoUrl      String? @map("video_url")
  transcriptUrl String? @map("transcript_url")

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@map("recordings")
}

// ─────────────────────────────────────────────────────────────────────────────
// Practice interview — a standalone, decoupled flow proving out the real
// voxio-webhook → scored-turn pipeline (brief: 6-topic rubric, see customs).
// Deliberately NOT tied to Cohort/Session/Vacancy/University — just User.
// ─────────────────────────────────────────────────────────────────────────────

// A company the student has self-registered for practice — created once,
// reused across any number of PracticeRound "sessions" under it. Research
// runs a single time at creation, not per session.
// An educator's institute — the practice-track counterpart to University.
// Carries the session quota for the same reason University does: every round
// is a live voice call plus (once per company) a Groq research call.
model PracticeOrg {
  id               String   @id @default(cuid())
  name             String
  // An org belongs to exactly one tenant: a medical institute never holds
  // interview companies and vice versa. Stored rather than derived from the
  // admin's email so the org keeps its identity if admins change.
  tenant           Tenant   @default(jer)
  sessionsAllotted Int      @default(0) @map("sessions_allotted")
  sessionsUsed     Int      @default(0) @map("sessions_used")
  createdAt        DateTime @default(now()) @map("created_at")

  admins    User[]
  groups    PracticeGroup[]
  companies PracticeCompany[]
  // Only populated on `nimc` orgs. Every other tenant leaves this empty.
  leads     Lead[]

  @@map("practice_orgs")
}

// A class / batch. Students self-enrol with `joinCode` rather than being
// bulk-imported, so they keep their own account and their course/CGPA.
model PracticeGroup {
  id        String   @id @default(cuid())
  orgId     String   @map("org_id")
  name      String
  joinCode  String   @unique @map("join_code")
  createdAt DateTime @default(now()) @map("created_at")

  org         PracticeOrg          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members     PracticeMember[]
  assignments PracticeAssignment[]

  @@index([orgId])
  @@map("practice_groups")
}

model PracticeMember {
  id       String   @id @default(cuid())
  groupId  String   @map("group_id")
  userId   String   @map("user_id")
  joinedAt DateTime @default(now()) @map("joined_at")

  group PracticeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("practice_members")
}

// One row per (company, student) the educator has assigned. This — not
// PracticeCompany.userId — is what grants an assigned student access to a
// shared company (see src/lib/practice/access.ts).
model PracticeAssignment {
  id          String                 @id @default(cuid())
  companyId   String                 @map("company_id")
  userId      String                 @map("user_id")
  // Provenance: which group the assignment came from, when it was assigned
  // in bulk. Null for an individually-assigned student.
  groupId     String?                @map("group_id")
  mode        PracticeAssignmentMode @default(drill)
  dueDate     DateTime?              @map("due_date")
  minSessions Int                    @default(1) @map("min_sessions")
  // Educator override for a locked (past grace period) assignment. Set to the
  // moment the educator reopened it; null means never unlocked. A timestamp
  // rather than a boolean so the roster can show WHEN it was reopened —
  // "unlocked" with no date is the kind of state nobody can audit later.
  unlockedAt  DateTime?              @map("unlocked_at")
  createdAt   DateTime               @default(now()) @map("created_at")

  company PracticeCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   PracticeGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([companyId, userId])
  @@index([userId])
  @@index([groupId])
  @@map("practice_assignments")
}

model PracticeCompany {
  id              String                @id @default(cuid())
  // Exactly one of userId / orgId is set. userId → a student registered this
  // for themselves (the original self-serve flow, still supported). orgId →
  // an educator created it for a batch, and access comes from
  // PracticeAssignment rather than ownership.
  userId          String?               @map("user_id")
  orgId           String?               @map("org_id")
  status          PracticeCompanyStatus @default(published)
  // `company` (jer) or `scenario` (nim) — see PracticeCompanyKind.
  kind            PracticeCompanyKind   @default(company)
  // Display title for both kinds. An employer name on a `company`
  // ("Razorpay"); the encounter on a `scenario` ("Mr Sharma, 78 — new
  // diabetes diagnosis").
  companyName     String                @map("company_name")
  // jobTitle / jobDescription / salaryLpa / tier / companyResearch are the
  // `company` half and stay null on scenario rows; `scenario` is the
  // `scenario` half and stays null on company rows.
  jobTitle        String?               @map("job_title")
  jobDescription  String?               @map("job_description")
  salaryLpa       Float?                @map("salary_lpa")
  tier            Tier? // company salary band, derived from salaryLpa
  companyResearch Json?                 @map("company_research")
  // The generated patient case — see ClinicalScenario in
  // src/lib/research/scenarioGeneration.ts. Educator-editable before publish,
  // then injected into the simulated patient's prompt.
  scenario        Json?
  // { greeting, prompt } for a `workflow` row — see CustomWorkflow in
  // src/lib/voice/workflowCustoms.ts. The whole definition of a cus session:
  // the customer's admin owns both strings outright, and an edit reaches
  // every one of their users on the next session with no publish step.
  workflow        Json?
  createdAt       DateTime              @default(now()) @map("created_at")

  user        User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  org         PracticeOrg?         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  rounds      PracticeRound[]
  // One per student, not one per company — a shared company carries a
  // separate resume chat for every student assigned to it.
  resumeChats   PracticeResumeChat[]
  // Tailored Resume Studio variants pointed at this company. Base resumes
  // carry a null companyId and so appear in none of these.
  resumeStudios PracticeResumeStudio[]
  assignments PracticeAssignment[]

  @@index([userId])
  @@index([orgId])
  @@map("practice_companies")
}

// One per (student, company) — a resumable-only career/resume chat, distinct
// from PracticeRound's timed, scored interview sessions. The unique
// constraint below is what enforces "resume the same thread, never start a
// second one": callers check for an existing row and either load it or show
// the upload screen, never create a second row for the same pair.
//
// The constraint is on the PAIR, not on companyId alone: a company can be
// shared across a whole batch, and each student uploads their own resume
// against it. Every read must be scoped by both ids — the resume text is
// injected verbatim into the live interviewer's prompt, so a company-only
// lookup would interview one student about another's projects.
model PracticeResumeChat {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  companyId  String   @map("company_id")
  resumeText String   @map("resume_text")
  // Full ai-sdk UIMessage[] transcript, stored verbatim.
  messages   Json     @default("[]")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  company PracticeCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
  @@map("practice_resume_chats")
}

// The Resume Studio artifact — a LaTeX resume the student builds by talking to
// the agent, distinct from PracticeResumeChat's "coach me on the resume I
// already have". That one READS a resume; this one WRITES one.
//
// Scoped per student, not per company: a resume is a thing you own, not a
// thing you own once per employer. `companyId` is therefore NULLABLE and
// means "the base resume". A non-null companyId is a TAILORED VARIANT, forked
// from the base and then reworded against that company's research — which is
// why `companyId` is optional here but required on PracticeResumeChat.
//
// That nullable column is also why there are two constraints below and not
// one. Postgres treats NULLs as distinct in a unique index, so
// @@unique([userId, companyId]) alone constrains the variants but lets a
// student accumulate unlimited base rows. The migration adds a partial unique
// index (WHERE company_id IS NULL) to close that; without it the "load the
// existing studio or create one" path races into duplicates.
model PracticeResumeStudio {
  id        String  @id @default(cuid())
  userId    String  @map("user_id")
  // null = the base resume. Non-null = a variant tailored for that company.
  companyId String? @map("company_id")

  // The compiled-in preamble is NOT stored here — only the body the model is
  // allowed to write. See src/lib/resume/template.ts for why that split is
  // what keeps LLM output compilable.
  resumeTex String @map("resume_tex")

  // The student's raw material: parsed PDF text, or whatever facts they typed
  // in to start. Kept verbatim and separate from resumeTex so the agent always
  // has the unedited ground truth to check itself against, and so a rewrite
  // that drops a real job can be caught rather than silently inherited.
  sourceText String @map("source_text")

  // Full ai-sdk UIMessage[] transcript, stored verbatim — same as
  // PracticeResumeChat.messages.
  messages Json @default("[]")

  // Cached compiler output, in R2 — the bytes used to sit in this row as a
  // `Bytes` column, which meant every query that forgot to `select` around it
  // dragged a whole PDF out of Postgres. NULL still means "recompile on next
  // read", and every write to resumeTex still nulls it. Cache, not source of
  // truth: a warm tectonic run is ~3.7s, far too slow for the request path of
  // a page view or an <iframe> load, but cheap enough to redo when missing.
  pdfKey String? @map("pdf_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  company PracticeCompany? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
  @@map("practice_resume_studios")
}

model PracticeRound {
  id           String      @id @default(cuid())
  userId       String      @map("user_id")
  status       RoundStatus @default(pending)
  overallScore Float?      @map("overall_score")
  startedAt    DateTime?   @map("started_at")
  completedAt  DateTime?   @map("completed_at")
  createdAt    DateTime    @default(now()) @map("created_at")

  recordingStatus RecordingStatus @default(none) @map("recording_status")

  // Where the video actually lives, in R2. The key rather than a URL: a bucket
  // rename or a move between presigned and custom-domain serving would other-
  // wise mean rewriting every row, and presigning needs the key regardless.
  // Null on a round whose recording never arrived — and on nothing else, since
  // the upload writes this in the same statement that flips status to `ready`.
  //
  // The content type is stored rather than re-derived because the container
  // (webm vs mp4) depends on what the recording browser supported. Guessing it
  // used to mean probing both extensions on disk; against object storage that
  // would be a network round trip on every page render.
  recordingKey         String? @map("recording_key")
  recordingContentType String? @map("recording_content_type")

  // The end-of-session debrief, written once by the webhook when the roleplay
  // graph's assessor node fires. `mm` only — that track is `scoring: false`
  // with no rubric, so this prose IS its entire assessment surface rather than
  // a summary layered on top of per-turn topic scores. Null everywhere else,
  // and null on an mm round that was abandoned before Mr Muthu ended it.
  // `overallScore` above is reused for the debrief's single 0-10 number.
  debriefFeedback String? @map("debrief_feedback")
  debriefSummary  String? @map("debrief_summary")

  // `pr` only. That track marks out of twenty across four dimensions, which is
  // a different scale from `overallScore` (0-10) rather than a rescaling of it,
  // so it gets its own column instead of overloading one number with two
  // meanings. `outcome` is the pass/retry/fail disposition off the running
  // score's status prefix — it drives the banner on the results page.
  debriefTotal    Int?    @map("debrief_total")
  outcome         String?

  // A session now always belongs to a PracticeCompany going forward; nullable
  // only because rows created before this model existed have nothing to
  // point at (see the legacy fields below, kept for those rows).
  companyId String? @map("company_id")

  // Legacy, denormalized company context from before PracticeCompany existed.
  // Left null on every new round (identity now lives on PracticeCompany) —
  // kept only so pre-existing rows keep rendering exactly as before.
  companyName     String? @map("company_name")
  jobTitle        String? @map("job_title")
  jobDescription  String? @map("job_description")
  salaryLpa       Float?  @map("salary_lpa")
  tier            Tier? // company salary band, derived from salaryLpa
  companyResearch Json?   @map("company_research")

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  company PracticeCompany? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  turns   PracticeTurn[]

  @@index([userId])
  @@index([companyId])
  @@map("practice_rounds")
}

model PracticeTurn {
  id              String   @id @default(cuid())
  practiceRoundId String   @map("practice_round_id")
  turnNumber      Int      @map("turn_number")
  speaker         Speaker
  transcript      String
  // The AI's spoken line this turn (agent turns only).
  speak           String?
  // Which avatar face the agent wore on this line — `mm` only, where the model
  // returns it alongside `speak` (see muthuPrompt.ts). Stored solely so the
  // live room can spot a CHANGE between consecutive turns and tell the officer
  // they just shifted Mr Muthu; the face itself is rendered backend-side into
  // the video, so nothing here drives what is on screen. Null on every other
  // tenant, none of which has a second face to switch to.
  frame           String?
  // The physical scene events the agent performed on this turn — `pr` only,
  // where the model returns e.g. ["receipt"] as the customer hands it over.
  // A string array stored as JSON because it is read whole and never queried
  // into. The live room turns each tag into something on screen.
  actions         Json?
  // The running STATUS_VALUE score at this point in the session ("retry_5"),
  // `pr` only. Kept per turn rather than only at the end so the score the
  // trainee watched move is recoverable afterwards.
  runningScore    String?  @map("running_score")
  // The 6-topic score dict this turn: { posture, framing, approach, numbers,
  // confidence, example } → { description, score (0-10), type_ }. Student
  // turns only; null on agent turns.
  topics          Json?
  timestamp       DateTime @default(now())

  round PracticeRound @relation(fields: [practiceRoundId], references: [id], onDelete: Cascade)

  @@index([practiceRoundId])
  @@map("practice_turns")
}

// Every raw payload the voxio webhook ever sends us, unconditionally — we
// don't yet know its exact wire shape, so nothing gets dropped or
// interpreted before it's captured verbatim.
model WebhookEvent {
  id         String   @id @default(cuid())
  source     String   @default("voxio_practice")
  rawBody    String   @map("raw_body")
  parsed     Json?
  receivedAt DateTime @default(now()) @map("received_at")

  @@map("webhook_events")
}

// ───────────────────────────── nimc: outbound calling ─────────────────────────
//
// One prospective student, keyed by the number we dial. The counsellor never
// picks a lead from a list — they type a number and press call — so this row is
// created as a silent upsert at dial time rather than imported ahead of time.
// The point of it existing at all is that repeat calls to the same number
// group: `attemptCount`, and later a callback queue, come for free, with no
// backfill needed the day we want them.
//
// The profile fields are filled in by the agent mid-call and merged by the
// webhook. Merge rule is deliberately dumb for now: a non-empty value
// overwrites, an empty one never does, last non-empty wins.
model Lead {
  id    String @id @default(cuid())
  orgId String @map("org_id")
  // E.164, e.g. +919876543210. Normalised before write — the unique index
  // below is the whole grouping mechanism, so an unnormalised number silently
  // creates a duplicate lead.
  phone String

  name           String?
  courseInterest String? @map("course_interest")
  // { level: "12th" | "graduation" | "masters", percent: "82" } as the agent
  // reported it. Json rather than a Float because the agent returns whatever
  // the student said ("around 82", "first division") and coercing that at the
  // webhook would lose the only record of what was actually claimed.
  academics      Json?
  // "jaipur" | "outside" — decides the bus-vs-hostel pitch in the prompt.
  residence      String?

  attemptCount Int       @default(0) @map("attempt_count")
  lastCallAt   DateTime? @map("last_call_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  org   PracticeOrg @relation(fields: [orgId], references: [id], onDelete: Cascade)
  calls LeadCall[]

  @@unique([orgId, phone])
  @@index([orgId])
  @@map("leads")
}

// One outbound call. `id` IS the session_id we hand to voxio: the row is
// written before the phone rings, so correlating the webhook back to it needs
// no lookup and no waiting on the dial response. (voxio will mint a session_id
// if we omit one, but then we'd have to wait for the response to learn it.)
model LeadCall {
  id           String @id @default(cuid())
  leadId       String @map("lead_id")
  counsellorId String @map("counsellor_id")
  // Denormalised from Lead so the history table renders without a join, and
  // so the row still says who was dialled if the lead is ever merged.
  phone        String

  // Null until we can tell. See CallOutcome — most values need a status
  // callback we don't consume yet.
  outcome CallOutcome?

  startedAt       DateTime  @default(now()) @map("started_at")
  endedAt         DateTime? @map("ended_at")
  durationSeconds Int?      @map("duration_seconds")

  lead       Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  counsellor User        @relation(fields: [counsellorId], references: [id], onDelete: Cascade)
  turns      LeadTurn[]

  @@index([leadId])
  @@index([counsellorId, startedAt])
  @@map("lead_calls")
}

// One utterance. The direct analogue of PracticeTurn, minus the rubric.
model LeadTurn {
  id         String      @id @default(cuid())
  callId     String      @map("call_id")
  turnNumber Int         @map("turn_number")
  speaker    CallSpeaker
  transcript String
  // The flat extraction snapshot for this turn — { name, course,
  // academic_percent, residence } as the agent returned it. Kept even after
  // it's merged onto Lead, so we can see when a value first appeared and what
  // it was before a later turn overwrote it.
  fields     Json?
  timestamp  DateTime    @default(now())

  call LeadCall @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@map("lead_turns")
}
